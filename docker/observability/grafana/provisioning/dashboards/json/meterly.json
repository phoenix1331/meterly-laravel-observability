{
  "title": "Meterly",
  "uid": "meterly-overview",
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "tags": ["meterly"],
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Technical signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second to the metered endpoint, by status code.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(app_http_requests_total{route=\"api/usage\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (fraud-check span, p50/p95)",
      "description": "Derived from real spans via Tempo's metrics-generator. Exemplars link a bucket straight to its trace.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"fraud-check.check\"}[1m])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"fraud-check.check\"}[1m])))",
          "legendFormat": "p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of requests failing (quota exceeded or upstream fraud-check failure).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 15 }, "max": 1, "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(app_http_requests_total{route=\"api/usage\",status=~\"429|502\"}[1m])) / sum(rate(app_http_requests_total{route=\"api/usage\"}[1m]))",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Horizon jobs per minute",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "app_horizon_jobs_per_minute",
          "legendFormat": "jobs/min"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Horizon status",
      "description": "-1 = inactive, 0 = paused, 1 = running.",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "inactive", "color": "red" } } },
            { "type": "value", "options": { "0": { "text": "paused", "color": "yellow" } } },
            { "type": "value", "options": { "1": { "text": "running", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "app_horizon_status"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue size",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "app_queue_size",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Recent app logs",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"app\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Business signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Plan mix",
      "description": "Tenant count by plan.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "app_tenants_by_plan",
          "legendFormat": "{{plan}}",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Revenue rate by plan",
      "description": "Monthly recurring revenue, in pence.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "app_revenue_rate_pence",
          "legendFormat": "{{plan}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Quota burn by tenant",
      "description": "Fraction of the monthly quota consumed per tenant. 1.0 means the quota is fully burnt.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "cellOptions": { "type": "color-background" } },
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.7, "color": "orange" },
              { "value": 1.0, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "app_tenant_quota_burn_ratio",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
