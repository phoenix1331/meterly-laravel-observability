// Pipeline 1: OTLP traces from the app (see TracingServiceProvider,
// OTEL_EXPORTER_OTLP_ENDPOINT in .env.example). The app only ever sends
// traces here. The metrics/logs outputs below exist for completeness with
// the OTLP receiver's shape but nothing in this app currently sends
// metrics or logs over OTLP; Prometheus scrapes /prometheus directly
// (see prometheus.yml) and logs arrive via the Docker discovery
// pipeline further down instead.
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces  = [otelcol.exporter.otlp.tempo.input]
		metrics = [otelcol.exporter.prometheus.default.input]
		logs    = [otelcol.exporter.loki.default.input]
	}
}

// Forwards received traces to Tempo over its own OTLP gRPC port.
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"
		tls {
			insecure = true
		}
	}
}

otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://prometheus:9090/api/v1/write"
	}
}

otelcol.exporter.loki "default" {
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// Pipeline 2: discover and tail the app's own containers via the Docker
// socket, so structured JSON logs written to stderr (config/logging.php's
// stderr channel) end up in Loki with the same trace_id that ties them
// to their span in Tempo. Separate from pipeline 1 above: the app
// never pushes logs itself, Alloy pulls them from Docker.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// Only these three containers run app code and write JSON logs;
	// everything else Docker discovers (mysql, redis, grafana itself,
	// ...) is skipped rather than ingested and immediately discarded
	// downstream.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/laravel-meterly-(app|horizon|scheduler)-.*"
		action        = "keep"
	}

	// "service" becomes the Loki label the dashboard's logs panel and
	// Grafana's derived-field trace link both query against
	// ({service="app"}, see the datasources.yml and meterly.json).
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/laravel-meterly-([a-z]+)-.*"
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.process.containers.receiver]
}

// Promotes two JSON fields to real Loki labels (queryable, not just
// grep-able text): trace_id (from TraceIdProcessor's extra.trace_id)
// is what makes Tempo's trace-to-logs "filterByTraceID" work (see the
// Tempo datasource's tracesToLogsV2 config), and level supports
// filtering the dashboard's logs panel by severity.
loki.process "containers" {
	stage.json {
		expressions = {
			trace_id = "extra.trace_id",
			level    = "level_name",
		}
	}

	stage.labels {
		values = {
			trace_id = "",
			level    = "",
		}
	}

	forward_to = [loki.write.default.receiver]
}
